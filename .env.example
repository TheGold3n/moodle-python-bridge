# ==============================================================================
# KioskBridge & Moodle Integration - Variables de Entorno de Ejemplo
# Copia este archivo como '.env' antes de iniciar el proyecto:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/macOS:          cp .env.example .env
# ==============================================================================

# --- Configuración Django (KioskBridge API) ---
SECRET_KEY=django-insecure-kioskbridge-demo-key-12345
DEBUG=True
ALLOWED_HOSTS=*

# --- Base de Datos MongoDB (Persistencia KioskBridge) ---
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
MONGO_INITDB_DATABASE=kioskbridge_db
MONGO_URI=mongodb://root:example@mongodb:27017/kioskbridge_db?authSource=admin

# --- Base de Datos MySQL (Requerida por Moodle) ---
MYSQL_ROOT_PASSWORD=moodle_root_password
MYSQL_DATABASE=moodle
MYSQL_USER=moodle_user
MYSQL_PASSWORD=moodle_password

# --- Configuración Moodle (Contenedor & Web Services) ---
# Nota: Para la comunicación interna dentro de Docker usar http://moodle:8080
# Para consumo desde el navegador del host usar http://localhost:8080
MOODLE_BASE_URL=http://localhost:8080
MOODLE_WS_TOKEN=
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Moodle123!
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_SITE_NAME=KioskBridge Moodle PoC
