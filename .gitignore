# ==============================================================================
# .gitignore - KioskBridge & Moodle Integration PoC
# Optimizado para repositorios públicos de portafolio / producción
# ==============================================================================

# --- Entornos Virtuales de Python ---
.venv/
.venv-*/
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Caché y Bytecode de Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Secretos y Variables de Entorno ---
# IMPORTANTE: Nunca subir credenciales reales ni tokens a repositorios públicos
.env
.env.local
.env.*.local
*.env
!.env.example

# --- Archivos de Base de Datos y Volúmenes Locales ---
*.sqlite3
*.db
mongo_data/
mysql_data/
moodle_data/
moodledata_data/

# --- Logs y Archivos Temporales ---
*.log
*.tmp
tags.txt
scratch/

# --- Configuración de Editores e IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# --- Archivos de Sistema Operativo ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Herramientas de IA y Antigravity ---
.gemini/

